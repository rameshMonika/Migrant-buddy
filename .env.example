# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# Langfuse (observability/tracing) -- leave unset to keep tracing disabled.
# Get these from your Langfuse project: Project Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST="https://jp.cloud.langfuse.com"

# Text-to-speech (ElevenLabs) -- required for the TTS service
# (migrantbuddy.tts.main) to work at all; no default, get these from
# your ElevenLabs account (API key) and the Voices tab (voice ID). Used to
# generate the audio that gets fed into LiveAvatar below via `repeatAudio`.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX

# LiveAvatar (docs.liveavatar.com, HeyGen ecosystem) -- required for the TTS
# service's /session/start to work at all; no default, get these from your
# LiveAvatar dashboard (API key, and the avatar_id of whichever avatar you've
# picked/created there).
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0

# Uncomment to override defaults (see src/migrantbuddy/config.py):
# MIGRANTBUDDY_OLLAMA_BASE_URL=http://localhost:11434
# MIGRANTBUDDY_VLLM_BASE_URL=http://localhost:8001
# MIGRANTBUDDY_GENERATION_BACKEND=ollama
# MIGRANTBUDDY_FRONTEND_ORIGIN=http://localhost:3000
# MIGRANTBUDDY_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# MIGRANTBUDDY_LIVEAVATAR_API_URL=https://api.liveavatar.com
# MIGRANTBUDDY_LIVEAVATAR_IS_SANDBOX=true
